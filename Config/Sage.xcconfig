ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
CODE_SIGN_STYLE = Automatic
COMBINE_HIDPI_IMAGES = YES
CURRENT_PROJECT_VERSION = 1
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_NSHumanReadableCopyright =
INFOPLIST_KEY_NSUserNotificationAlertStyle = alert
INFOPLIST_KEY_NSAppleEventsUsageDescription = Sage uses Apple Events to toggle Light/Dark appearance when you ask it to.
INFOPLIST_KEY_NSRemindersUsageDescription = Sage creates reminders in the Reminders app when you ask it to.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
MARKETING_VERSION = 1.0
PRODUCT_BUNDLE_IDENTIFIER = mozheng.Sage
PRODUCT_NAME = $(TARGET_NAME)
REGISTER_APP_GROUPS = YES
STRING_CATALOG_GENERATE_SYMBOLS = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
